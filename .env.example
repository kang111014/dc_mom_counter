# ===== Discord 機器人 =====
# 機器人的 Token（Discord Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=
# 你的私人伺服器 ID（伺服器名稱按右鍵 → 複製伺服器 ID）
GUILD_ID=
# 你自己的使用者 ID，只有這個人能用 /開始、/結束、/詞庫、/同義
OWNER_ID=

# ===== 語音辨識 =====
# 模型：large-v3-turbo（推薦）、large-v3（較準但較慢）、medium、small
WHISPER_MODEL=large-v3-turbo
# cuda = 用顯示卡；顯示卡出問題時改成 cpu
WHISPER_DEVICE=cuda
# zh = 中文（中英混用也可以）；留空 = 自動偵測
WHISPER_LANGUAGE=zh

# 收音測試用：設成 1 會把每段聲音存到 recordings/ 資料夾，確認完請改回 0
SAVE_AUDIO=0

# Python 服務的連接埠，通常不用改
SERVICE_PORT=8765
